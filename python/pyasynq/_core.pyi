import asyncio
from datetime import datetime, timedelta
from typing import Any, Callable, Generic, Literal, final

from typing_extensions import Self, TypeVar, disjoint_base

_R_co = TypeVar("_R_co", covariant=True, default=Any)

TaskState = Literal["pending", "active", "scheduled", "retry", "archived", "completed", "aggregating"]
Duration = float | timedelta

ALL_QUEUES: str
ASYNQ_VERSION: str

def version() -> str: ...
def reset_log_cache() -> None: ...
def queue_key_prefix(qname: str) -> str: ...
def task_key(qname: str, id: str) -> str: ...
def pending_key(qname: str) -> str: ...
def default_retry_delay_seconds(retried: int) -> float: ...

class AsynqError(Exception): ...
class DuplicateTaskError(AsynqError): ...
class TaskIDConflictError(AsynqError): ...
class TaskNotFoundError(AsynqError): ...
class RedisError(AsynqError): ...
class QueueNotFoundError(AsynqError): ...
class FailedPreconditionError(AsynqError): ...

@final
class TaskMessage:
    """The protobuf stored under the `msg` field of every task hash."""

    type: str
    payload: bytes
    headers: dict[str, str]
    id: str
    queue: str
    retry: int
    retried: int
    error_msg: str
    last_failed_at: int
    timeout: int
    deadline: int
    unique_key: str
    group_key: str
    retention: int
    completed_at: int
    def __new__(
        cls,
        task_type: str,
        payload: bytes = ...,
        *,
        headers: dict[str, str] = ...,
        id: str = ...,
        queue: str = ...,
        retry: int = 0,
        retried: int = 0,
        error_msg: str = ...,
        last_failed_at: int = 0,
        timeout: int = 0,
        deadline: int = 0,
        unique_key: str = ...,
        group_key: str = ...,
        retention: int = 0,
        completed_at: int = 0,
    ) -> Self: ...
    def encode(self) -> bytes: ...
    @staticmethod
    def decode(data: bytes) -> TaskMessage: ...

@final
class TaskInfo(Generic[_R_co]):
    """A task's state in Redis. The type parameter is the decoded result
    type of the task that produced it (see `TaskDef.wait_result`)."""

    @property
    def id(self) -> str: ...
    @property
    def queue(self) -> str: ...
    @property
    def type(self) -> str: ...
    @property
    def payload(self) -> bytes: ...
    @property
    def headers(self) -> dict[str, str]: ...
    @property
    def state(self) -> TaskState: ...
    @property
    def max_retry(self) -> int: ...
    @property
    def retried(self) -> int: ...
    @property
    def last_err(self) -> str | None: ...
    @property
    def timeout(self) -> timedelta | None: ...
    @property
    def deadline(self) -> datetime | None: ...
    @property
    def group(self) -> str | None: ...
    @property
    def retention(self) -> timedelta | None: ...
    @property
    def next_process_at(self) -> datetime | None: ...
    @property
    def result(self) -> bytes | None:
        """Raw bytes written by the handler, while the task is retained."""
    @property
    def completed_at(self) -> datetime | None: ...
    @property
    def last_failed_at(self) -> datetime | None: ...

@disjoint_base
class Client:
    def __new__(cls, url: str = "redis://127.0.0.1:6379/0") -> Self: ...
    def ping(self) -> None: ...
    def _aping(self) -> asyncio.Future[None]: ...
    def enqueue(
        self,
        task_type: str,
        payload: bytes | None = None,
        *,
        queue: str | None = None,
        max_retry: int | None = None,
        task_id: str | None = None,
        timeout: Duration | None = None,
        deadline: datetime | None = None,
        unique: Duration | None = None,
        process_at: datetime | None = None,
        process_in: Duration | None = None,
        retention: Duration | None = None,
        group: str | None = None,
        headers: dict[str, str] | None = None,
    ) -> TaskInfo: ...
    def _aenqueue(
        self,
        task_type: str,
        payload: bytes | None = None,
        *,
        queue: str | None = None,
        max_retry: int | None = None,
        task_id: str | None = None,
        timeout: Duration | None = None,
        deadline: datetime | None = None,
        unique: Duration | None = None,
        process_at: datetime | None = None,
        process_in: Duration | None = None,
        retention: Duration | None = None,
        group: str | None = None,
        headers: dict[str, str] | None = None,
    ) -> asyncio.Future[TaskInfo]: ...

@final
class Broker:
    def __new__(cls, url: str = "redis://127.0.0.1:6379/0") -> Self: ...
    def dequeue(self, *queues: str) -> tuple[TaskMessage, datetime] | None: ...
    def done(self, msg: TaskMessage) -> None: ...
    def mark_as_complete(self, msg: TaskMessage) -> None: ...

EngineEvent = (
    tuple[Literal["job"], TaskMessage, datetime]
    | tuple[Literal["cancel"], str, str]
    | tuple[Literal["aggregate"], str, str, str, list[TaskMessage]]
    | tuple[Literal["health"], str | None]
    | tuple[Literal["closed"]]
)

@disjoint_base
class Engine:
    def __new__(
        cls,
        url: str = "redis://127.0.0.1:6379/0",
        *,
        concurrency: int | None = None,
        queues: dict[str, int] | None = None,
        strict_priority: bool = False,
        task_check_interval: float = 1.0,
        delayed_task_check_interval: float = 5.0,
        shutdown_timeout: float = 8.0,
        health_check_interval: float = 15.0,
        heartbeat_interval: float = 5.0,
        lease_duration: float = 30.0,
        recoverer_interval: float = 60.0,
        recoverer_skew: float = 30.0,
        janitor_interval: float = 8.0,
        janitor_batch_size: int = 100,
        sync_interval: float = 5.0,
        cancel_grace: float = 5.0,
        group_aggregation: bool = False,
        group_grace_period: float = 60.0,
        group_max_delay: float = 0.0,
        group_max_size: int = 0,
        failure_policy: Callable[[int, str, TaskMessage], tuple[float, bool]] | None = None,
    ) -> Self: ...
    def _astart(self) -> asyncio.Future[None]: ...
    def _anext_events(self, max: int = 256) -> asyncio.Future[list[EngineEvent] | None]: ...
    def ack(
        self,
        task_id: str,
        kind: Literal["success", "retry", "archive", "revoke"],
        *,
        error: str = "",
        retry_in: float = 0.0,
        is_failure: bool = True,
        result: bytes | None = None,
    ) -> bool: ...
    def _awrite_result(self, queue: str, task_id: str, data: bytes) -> asyncio.Future[int]: ...
    def _acomplete_aggregation(self, queue: str, group: str, set_id: str) -> asyncio.Future[None]: ...
    def stop(self) -> None: ...
    def _ashutdown(self) -> asyncio.Future[None]: ...
    @property
    def status(self) -> str: ...
    @property
    def server_id(self) -> str: ...
    @property
    def host(self) -> str: ...
    @property
    def pid(self) -> int: ...
    @property
    def concurrency(self) -> int: ...
    @property
    def queues(self) -> dict[str, int]: ...
    @property
    def active_count(self) -> int: ...

