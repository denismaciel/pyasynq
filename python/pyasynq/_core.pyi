@disjoint_base
class Inspector:
    def __new__(cls, url: str = "redis://127.0.0.1:6379/0") -> Self: ...
    def queues(self) -> list[str]: ...
    def get_queue_info(self, queue: str) -> QueueInfo: ...
    def history(self, queue: str, days: int = 7) -> list[DailyStats]: ...
    def groups(self, queue: str) -> dict[str, int]: ...
    def get_task_info(self, queue: str, task_id: str) -> TaskInfo: ...
    def _aget_task_info(self, queue: str, task_id: str) -> asyncio.Future[TaskInfo]: ...
    def list_tasks(
        self, queue: str, state: TaskState, *, group: str | None = None, page: int = 1, size: int = 30
    ) -> list[TaskInfo]: ...
    def delete_task(self, queue: str, task_id: str) -> None: ...
    def run_task(self, queue: str, task_id: str) -> None: ...
    def archive_task(self, queue: str, task_id: str) -> None: ...
    def update_task_payload(self, queue: str, task_id: str, payload: bytes) -> None: ...
    def delete_all_tasks(self, queue: str, state: TaskState, *, group: str | None = None) -> int: ...
    def run_all_tasks(self, queue: str, state: TaskState, *, group: str | None = None) -> int: ...
    def archive_all_tasks(self, queue: str, state: TaskState, *, group: str | None = None) -> int: ...
    def cancel_processing(self, task_id: str) -> None: ...
    def delete_queue(self, queue: str, *, force: bool = False) -> None: ...
    def pause_queue(self, queue: str) -> None: ...
    def unpause_queue(self, queue: str) -> None: ...
    def servers(self) -> list[ServerInfo]: ...
    def scheduler_entries(self) -> list[SchedulerEntry]: ...
    def list_scheduler_enqueue_events(
        self, entry_id: str, *, page: int = 1, size: int = 30
    ) -> list[SchedulerEnqueueEvent]: ...

@disjoint_base
class Scheduler:
    def __new__(
        cls,
